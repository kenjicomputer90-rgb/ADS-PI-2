model User {
  id    Int     @id @default(autoincrement())
  nome string
  cpf number 
  rg number
  data_nacimento string
}

model Funcionario {
  id  number
  nome  string
  cpf number
  rg  number
  email string
  telefone  number
  cpts  number
  dependentes number
  sexo  string
  salario  number
  data_de_nascimento  string
  estado_civil  string
}
