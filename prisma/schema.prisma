generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
 
}

model Cliente {
  id               Int    @id @default(autoincrement())
  nome             String
  cpf              String
  rg               String
  data_nascimento  String
}

model Funcionario {
  id                 Int    @id @default(autoincrement())
  nome               String
  cpf                String
  rg                 String
  email              String
  telefone           String
  cpts               String
  dependentes        Int
  sexo               String
  salario            Float
  data_de_nascimento String
  estado_civil       String
}